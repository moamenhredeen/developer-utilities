{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "developer-utilities",
  "compatibility_date": "2026-08-19",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "tools.moamenhredeen.me",
      "custom_domain": true
    }
  ]
}
